      "enum": [
        "internal",
        "external",
        "free-call"
      ]
    },
    "url": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "external"
          ]
        }
      },
      "required": false
    }
  },
  "config": {}
}
