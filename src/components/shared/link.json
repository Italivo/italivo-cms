{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "icon": "link"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "internal",
        "external"
      ]
    },
    "externalUrl": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "external"
          ]
        }
      },
      "required": false
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "internal"
          ]
        }
      }
    },
    "target": {
      "type": "enumeration",
      "required": false,
      "default": "_self",
      "enum": [
        "_self",
        "_blank"
      ]
    }
  },
  "config": {}
}
