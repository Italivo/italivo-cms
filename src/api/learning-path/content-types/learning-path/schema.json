{
  "kind": "collectionType",
  "collectionName": "learning_paths",
  "info": {
    "singularName": "learning-path",
    "pluralName": "learning-paths",
    "displayName": "Learning Path"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": false
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "tagline": {
      "type": "text",
      "required": true
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "package_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::package-category.package-category",
      "inversedBy": "learning_paths"
    }
  }
}
