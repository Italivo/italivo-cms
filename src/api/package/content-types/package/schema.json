{
  "kind": "collectionType",
  "collectionName": "packages",
  "info": {
    "singularName": "package",
    "pluralName": "packages",
    "displayName": "Package"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "package_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::package-category.package-category",
      "inversedBy": "packages"
    },
    "summary": {
      "type": "richtext",
      "required": true
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 1,
      "min": 1
    }
  }
}
